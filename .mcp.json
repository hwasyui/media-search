{
  "mcpServers": {
    "media-search-db": {
      "command": "node_modules/@toolbox-sdk/server-win32-x64/bin/toolbox.exe",
      "args": [
        "--config",
        "mcp/tools.yaml",
        "--stdio",
        "--disable-version-check",
        "--disable-reload"
      ],
      "env": {
        "MCP_DB_HOST": "${MCP_DB_HOST:-localhost}",
        "MCP_DB_PORT": "${MCP_DB_PORT:-3306}",
        "MCP_DB_USER": "${MCP_DB_USER}",
        "MCP_DB_PASSWORD": "${MCP_DB_PASSWORD}"
      }
    }
  }
}
