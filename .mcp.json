{
  "mcpServers": {
    "media-search-db": {
      "command": "npx",
      "args": ["-y", "@maxlmgc/mysql-mcp@1.0.9"],
      "env": {
        "MYSQL_HOST": "${MCP_DB_HOST:-localhost}",
        "MYSQL_PORT": "${MCP_DB_PORT:-3306}",
        "MYSQL_USER": "${MCP_DB_USER}",
        "MYSQL_PASS": "${MCP_DB_PASSWORD}",
        "MYSQL_DB": "media-search",
        "MYSQL_READONLY": "true",
        "MYSQL_MULTIPLE_STATEMENTS": "false",
        "MYSQL_CONNECTION_LIMIT": "3"
      }
    }
  }
}
