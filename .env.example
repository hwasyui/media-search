# Salin menjadi .env lalu isi. JANGAN commit .env (berisi rahasia).

# ── AI ─────────────────────────────────────────────
# Klasifikasi & analisis: Groq lebih dulu, cadangan otomatis ke Gemini bila kuota Groq habis.
# Tambah key lain dengan akhiran angka (GROQ_API_KEY2, GEMINI_API_KEY2, ...). Asisten chat memakai Gemini lebih dulu.
GROQ_API_KEY=
GROQ_API_KEY2=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_API_KEY2=
GEMINI_MODEL=gemini-3.5-flash-lite
# Batas jumlah berita yang dikirim ke AI per run
AI_MAX_ITEMS=500

# ── Server ─────────────────────────────────────────
PORT=3000
# Data keuangan emiten dipakai dari snapshot DB selama N jam (diperbarui lewat tombol / Task Runner)
FINANCIAL_TTL_HOURS=24

# ── MySQL (schema aplikasi: media-search; jalankan `npm run db:init` sekali) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
# Nama schema aplikasi (default: media-search)
MEDIA_DB_NAME=media-search

# ── MCP / chatbot eksternal (user MySQL KHUSUS read-only; lihat db/mcp_readonly_user.sql) ──
# Dibaca oleh .mcp.json lewat variabel lingkungan, bukan oleh server ini.
MCP_DB_USER=
MCP_DB_PASSWORD=
