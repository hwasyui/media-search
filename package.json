{
  "name": "media-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.js",
    "build": "next build",
    "start": "node --env-file-if-exists=.env server.js --prod",
    "cron-crawl": "node --env-file-if-exists=.env scripts/crawl/cron-crawl.js",
    "db:init": "node --env-file-if-exists=.env scripts/db/db-init.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop media-search",
    "pm2:restart": "pm2 restart media-search --update-env",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs media-search --lines 100",
    "pm2:delete": "pm2 delete media-search"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.12.0",
    "google-news-url-decoder": "^1.2.2",
    "mysql2": "^3.24.6",
    "next": "^16.4.5",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pm2": "^7.1.2",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@toolbox-sdk/server-linux-x64": "1.15.0",
    "@toolbox-sdk/server-win32-x64": "1.15.0"
  }
}
