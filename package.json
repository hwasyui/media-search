{
  "name": "media-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "simulate": "node --env-file-if-exists=.env scripts/simulate.js",
    "cron-crawl": "node --env-file-if-exists=.env scripts/cron-crawl.js",
    "db:init": "node --env-file-if-exists=.env scripts/db-init.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop media-search",
    "pm2:restart": "pm2 restart media-search --update-env",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs media-search --lines 100",
    "pm2:delete": "pm2 delete media-search"
  },
  "dependencies": {
    "express": "^4.21.0",
    "google-news-url-decoder": "^1.2.2",
    "mysql2": "^3.24.6",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "pm2": "^7.1.2"
  }
}
